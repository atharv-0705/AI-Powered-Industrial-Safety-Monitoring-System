# --- App Configuration ---
APP_NAME=Multimodal Safety AI Monitor
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Video Ingestion (FR-01, FR-03) ---
# 0 = default webcam. Or a local path: data/sample.mp4 (Windows/WSL)
VIDEO_SOURCE=0
SOURCE_FPS=30
PROCESSING_FPS=12
MAX_QUEUE_SIZE=2

# --- Detection + Tracking (FR-04, FR-06 — SRS §8.2) ---
DETECTOR_MODEL=yolo11n.pt
DETECTOR_CONF_THRESHOLD=0.4
DETECTOR_IMG_SIZE=640
DETECTOR_DEVICE=auto
TRACKER_CONFIG=bytetrack.yaml

# --- HAR Model (FR-08 — SRS §8.4) ---
HAR_CHECKPOINT_PATH=models/har_temporal_transformer.pt
HAR_DEVICE=auto

# --- PPE Detection (Week 5, FR-05) ---
PPE_MODEL_PATH=models/ppe_yolo11n.pt
PPE_CONF_THRESHOLD=0.4
PPE_DEVICE=auto

# --- Safety Rules & Thresholds (Week 6-8) ---
FALL_ASPECT_RATIO_THRESHOLD=0.8
FALL_CONFIRMATION_FRAMES=6
RESTRICTED_ZONE_COORDS=[]

# --- Vision-Language Model (Week 9, FR-16..FR-20) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
VLM_ENABLED=false
VLM_RATE_LIMIT_SECONDS=10

# --- Database Storage (Week 10, FR-22) ---
DATABASE_URL=sqlite:///./data/safety_monitor.db
